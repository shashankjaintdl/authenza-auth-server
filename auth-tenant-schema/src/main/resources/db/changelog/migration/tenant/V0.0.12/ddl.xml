<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Drop deprecated local client table from Tenant database -->
    <changeSet id="v0.0.12-drop-local-oauth2-client-table" author="authenza">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="oauth2_registered_client"/>
        </preConditions>
        <dropTable tableName="oauth2_registered_client"/>
    </changeSet>
</databaseChangeLog>
