    <changeSet id="V0.0.13-seed-adaptive_new_ip_lookback_days" author="authenza">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM tenant_settings WHERE setting_key = 'adaptive_new_ip_lookback_days'
            </sqlCheck>
        </preConditions>
        <insert tableName="tenant_settings">
            <column name="setting_key" value="adaptive_new_ip_lookback_days"/>
            <column name="setting_value" value="30"/>
        </insert>
    </changeSet>
</databaseChangeLog>
