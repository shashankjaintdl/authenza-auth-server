    </changeSet>

    <changeSet id="V0.0.13-seed-adaptive_fail_mode" author="authenza">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM tenant_settings WHERE setting_key = 'adaptive_fail_mode'
            </sqlCheck>
        </preConditions>
