<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        TENANT INITIALIZATION DDL — Phase 5 placeholder
        ══════════════════════════════════════════════════════════════════

        Purpose:
          Creates the one-time baseline schema for every new tenant database.
          Runs via TenantProvisioningService BEFORE migration/tenant/db.changelog-tenant.xml.

        Tables to move here from migration/tenant/V0.0.1/ddl.xml in Phase 5:
          - application_user
          - roles
          - role_permissions
          - user_roles
          - oauth2_registered_client
          - oauth2_authorization
          - oauth2_authorization_consent
          - oauth2_authorization_server_settings

        Also include final stable tables (from later migrations once they settle):
          - tenant_settings          (currently V0.0.7)
          - failed_login_attempts    (brute force, currently V0.0.6)
          - mfa columns on application_user (currently V0.0.6)

        ⚠️  Do NOT add changesets here until Phase 5.
            Moving changesets requires updating DATABASECHANGELOG checksums
            on all existing tenant databases.
        ══════════════════════════════════════════════════════════════════
    -->

     <!-- ═══════════════════════════════════════════════════════════════
         V0.0.1 — OAuth2 Registered Client Table
         Source: V0.0.1/ddl.xml
         ═══════════════════════════════════════════════════════════════ -->

    <changeSet id="002-create-oauth2-client-table" author="admin">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="oauth2_registered_client"/></not>
        </preConditions>
        <createTable tableName="oauth2_registered_client">
            <column name="id" type="VARCHAR(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="client_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="client_id_issued_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="client_secret" type="VARCHAR(200)"/>
            <column name="client_secret_expires_at" type="TIMESTAMP"/>
            <column name="client_name" type="VARCHAR(200)"/>
            <column name="client_authentication_methods" type="VARCHAR(1000)"/>
            <column name="authorization_grant_types" type="VARCHAR(1000)"/>
            <column name="redirect_uris" type="VARCHAR(1000)"/>
            <column name="post_logout_redirect_uris" type="VARCHAR(1000)"/>
            <column name="scopes" type="VARCHAR(1000)"/>
            <column name="client_settings" type="TEXT"/>
            <column name="token_settings" type="TEXT"/>
        </createTable>
    </changeSet>


    <!-- ═══════════════════════════════════════════════════════════════
         V0.0.3 — IAM Core Tables
         Source: V0.0.3/ddl.xml
         Tables: application_user, authority, role, role_authority,
                 user_role + indexes
         ═══════════════════════════════════════════════════════════════ -->

    <changeSet id="003-create-iam-tables" author="root">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="application_user"/></not>
        </preConditions>

        <!-- 1. application_user -->
        <createTable tableName="application_user">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="preferred_username" type="VARCHAR(150)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="VARCHAR(255)"/>
            <column name="given_name" type="VARCHAR(100)"/>
            <column name="family_name" type="VARCHAR(100)"/>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="email_verified" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="phone_number" type="VARCHAR(20)"/>
            <column name="phone_number_verified" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="picture" type="VARCHAR(500)"/>
            <column name="locale" type="VARCHAR(10)"/>
            <column name="zoneinfo" type="VARCHAR(50)"/>
            <column name="gender" type="VARCHAR(20)"/>
            <column name="birthdate" type="VARCHAR(10)"/>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(30)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="failed_login_attempts" type="INT" defaultValueNumeric="0"/>
            <column name="locked_until" type="TIMESTAMP"/>
            <column name="password_changed_at" type="TIMESTAMP"/>
            <column name="mfa_enabled" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="last_login_at" type="TIMESTAMP"/>
            <column name="last_login_ip" type="VARCHAR(45)"/>
        </createTable>

        <!-- 2. authority -->
        <createTable tableName="authority">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="permission" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="display_name" type="VARCHAR(150)"/>
            <column name="description" type="VARCHAR(500)"/>
            <column name="category" type="VARCHAR(100)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- 3. role -->
        <createTable tableName="role">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="display_name" type="VARCHAR(150)"/>
            <column name="description" type="VARCHAR(500)"/>
            <column name="system_default" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <!-- 4. role_authority -->
        <createTable tableName="role_authority">
            <column name="role_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="authority_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="role_authority" columnNames="role_id, authority_id" constraintName="pk_role_authority"/>
        <addForeignKeyConstraint baseTableName="role_authority" baseColumnNames="role_id"
                                 referencedTableName="role" referencedColumnNames="id"
                                 constraintName="fk_role_authority_role" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="role_authority" baseColumnNames="authority_id"
                                 referencedTableName="authority" referencedColumnNames="id"
                                 constraintName="fk_role_authority_authority" onDelete="CASCADE"/>

        <!-- 5. user_role -->
        <createTable tableName="user_role">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="role_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="user_role" columnNames="user_id, role_id" constraintName="pk_user_role"/>
        <addForeignKeyConstraint baseTableName="user_role" baseColumnNames="user_id"
                                 referencedTableName="application_user" referencedColumnNames="id"
                                 constraintName="fk_user_role_user" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="user_role" baseColumnNames="role_id"
                                 referencedTableName="role" referencedColumnNames="id"
                                 constraintName="fk_user_role_role" onDelete="CASCADE"/>

        <!-- 6. Performance Indexes -->
        <createIndex tableName="application_user" indexName="idx_user_email">
            <column name="email"/>
        </createIndex>
        <createIndex tableName="application_user" indexName="idx_user_preferred_username">
            <column name="preferred_username"/>
        </createIndex>
        <createIndex tableName="application_user" indexName="idx_user_phone_number">
            <column name="phone_number"/>
        </createIndex>
        <createIndex tableName="application_user" indexName="idx_user_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="authority" indexName="idx_authority_permission">
            <column name="permission"/>
        </createIndex>
        <createIndex tableName="authority" indexName="idx_authority_category">
            <column name="category"/>
        </createIndex>
        <createIndex tableName="role" indexName="idx_role_name">
            <column name="name"/>
        </createIndex>
    </changeSet>


    <!-- ═══════════════════════════════════════════════════════════════
         V0.0.4 — Tenant Settings & Token Tables
         Source: V0.0.4/ddl.xml
         Tables: tenant_smtp_settings, tenant_branding_settings,
                 email_verification_token
         ═══════════════════════════════════════════════════════════════ -->

    <changeSet id="010-create-tenant-smtp-settings" author="admin">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="tenant_smtp_settings"/></not>
        </preConditions>
        <createTable tableName="tenant_smtp_settings">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="host" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="port" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(255)"/>
            <column name="password" type="VARCHAR(255)"/>
            <column name="protocol" type="VARCHAR(50)" defaultValue="smtp"/>
            <column name="auth_enabled" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="starttls_enabled" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="sender_email" type="VARCHAR(255)"/>
            <column name="sender_name" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="011-create-tenant-branding-settings" author="admin">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="tenant_branding_settings"/></not>
        </preConditions>
        <createTable tableName="tenant_branding_settings">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="logo_url" type="VARCHAR(1024)"/>
            <column name="primary_color" type="VARCHAR(50)" defaultValue="#0F172A"/>
            <column name="secondary_color" type="VARCHAR(50)" defaultValue="#38BDF8"/>
            <column name="company_name" type="VARCHAR(255)"/>
            <column name="support_email" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="010-create-email-verification-token" author="admin">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="email_verification_token"/></not>
        </preConditions>
        <createTable tableName="email_verification_token">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="token" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="token_type" type="VARCHAR(30)" defaultValue="EMAIL_VERIFICATION">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="email_verification_token"
                baseColumnNames="user_id"
                referencedTableName="application_user"
                referencedColumnNames="id"
                constraintName="fk_verification_token_user"
                onDelete="CASCADE"/>
    </changeSet>


    <!-- ═══════════════════════════════════════════════════════════════
         V0.0.6 — MFA Secret Column
         Source: V0.0.6/ddl.xml
         ═══════════════════════════════════════════════════════════════ -->

    <changeSet id="012-add-mfa-secret-to-application-user" author="admin">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="application_user" columnName="mfa_secret"/>
            </not>
        </preConditions>
        <addColumn tableName="application_user">
            <column name="mfa_secret" type="VARCHAR(256)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>


    <!-- ═══════════════════════════════════════════════════════════════
         V0.0.7 — Tenant Settings Table
         Source: V0.0.7/ddl.xml  (DDL part only — inserts are in dml.xml)
         ═══════════════════════════════════════════════════════════════ -->

    <changeSet id="V0.0.7-1-create-tenant-settings" author="authenza">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tenant_settings"/>
            </not>
        </preConditions>
        <createTable tableName="tenant_settings">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="setting_key" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="setting_value" type="VARCHAR(500)">
                <constraints nullable="true"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>


    <!-- ═══════════════════════════════════════════════════════════════
         V0.0.8 — OAuth2 Authorization & Session Tables
         Source: V0.0.8/ddl.xml
         Tables: oauth2_authorization, oauth2_authorization_consent,
                 user_session
         ═══════════════════════════════════════════════════════════════ -->

    <changeSet id="V0.0.8-1-create-oauth2-authorization" author="authenza">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="oauth2_authorization"/>
            </not>
        </preConditions>
        <createTable tableName="oauth2_authorization">
            <column name="id" type="VARCHAR(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="registered_client_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="principal_name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="authorization_grant_type" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="authorized_scopes" type="VARCHAR(1000)"/>
            <column name="attributes" type="BLOB"/>
            <column name="state" type="VARCHAR(500)"/>
            <!-- Authorization Code -->
            <column name="authorization_code_value" type="BLOB"/>
            <column name="authorization_code_issued_at" type="TIMESTAMP"/>
            <column name="authorization_code_expires_at" type="TIMESTAMP"/>
            <column name="authorization_code_metadata" type="BLOB"/>
            <!-- Access Token -->
            <column name="access_token_value" type="BLOB"/>
            <column name="access_token_issued_at" type="TIMESTAMP"/>
            <column name="access_token_expires_at" type="TIMESTAMP"/>
            <column name="access_token_metadata" type="BLOB"/>
            <column name="access_token_type" type="VARCHAR(100)"/>
            <column name="access_token_scopes" type="VARCHAR(1000)"/>
            <!-- OIDC ID Token -->
            <column name="oidc_id_token_value" type="BLOB"/>
            <column name="oidc_id_token_issued_at" type="TIMESTAMP"/>
            <column name="oidc_id_token_expires_at" type="TIMESTAMP"/>
            <column name="oidc_id_token_metadata" type="BLOB"/>
            <column name="oidc_id_token_claims" type="BLOB"/>
            <!-- Refresh Token -->
            <column name="refresh_token_value" type="BLOB"/>
            <column name="refresh_token_issued_at" type="TIMESTAMP"/>
            <column name="refresh_token_expires_at" type="TIMESTAMP"/>
            <column name="refresh_token_metadata" type="BLOB"/>
            <!-- Device Code (RFC 8628) -->
            <column name="user_code_value" type="BLOB"/>
            <column name="user_code_issued_at" type="TIMESTAMP"/>
            <column name="user_code_expires_at" type="TIMESTAMP"/>
            <column name="user_code_metadata" type="BLOB"/>
            <column name="device_code_value" type="BLOB"/>
            <column name="device_code_issued_at" type="TIMESTAMP"/>
            <column name="device_code_expires_at" type="TIMESTAMP"/>
            <column name="device_code_metadata" type="BLOB"/>
        </createTable>
    </changeSet>

    <changeSet id="V0.0.8-2-create-oauth2-authorization-consent" author="authenza">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="oauth2_authorization_consent"/>
            </not>
        </preConditions>
        <createTable tableName="oauth2_authorization_consent">
            <column name="registered_client_id" type="VARCHAR(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="principal_name" type="VARCHAR(200)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="authorities" type="VARCHAR(1000)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="V0.0.8-3-create-user-session" author="authenza">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="user_session"/>
            </not>
        </preConditions>
        <createTable tableName="user_session">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <!-- Soft-link to oauth2_authorization.id — nullable because the
                 OAuth2 record may not exist yet when the session row is created -->
            <column name="authorization_id" type="VARCHAR(100)"/>
            <column name="session_token" type="VARCHAR(200)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="ip_address" type="VARCHAR(45)"/>
            <column name="user_agent" type="VARCHAR(500)"/>
            <!-- Human-readable device label parsed from the User-Agent header -->
            <column name="device_name" type="VARCHAR(200)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_active_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMP"/>
            <column name="revoked" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="revoked_at" type="TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="user_session"
                baseColumnNames="user_id"
                constraintName="fk_user_session_user"
                referencedTableName="application_user"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
