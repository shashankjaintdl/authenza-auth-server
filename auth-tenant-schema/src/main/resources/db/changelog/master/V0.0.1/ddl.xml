<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Master DB only contains the tenant registry table.
         No OAuth2, User, Role, or Authority tables belong here. -->

    <changeSet id="0101-create-tenants-table" author="root">
        <createTable tableName="tenants">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="VARCHAR(100)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="db_type" type="VARCHAR(20)"/>
            <column name="jdbc_url" type="VARCHAR(255)"/>
            <column name="username" type="VARCHAR(100)"/>
            <column name="encrypted_password" type="VARCHAR(255)"/>
            <column name="driver_class_name" type="VARCHAR(100)"/>
            <column name="active" type="VARCHAR(20)"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
